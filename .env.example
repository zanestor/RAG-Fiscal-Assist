# Provider routing: auto prefers OpenAI File Search and falls back to OpenRouter + local retrieval.
FISCAL_RAG_PROVIDER=auto
FISCAL_RAG_FALLBACK_ENABLED=true
FISCAL_RAG_HISTORY_ENABLED=true
FISCAL_RAG_DATA_DIR=%LOCALAPPDATA%\RAF_Fiscal_Assistant
FISCAL_RAG_GPA_PATH=
FISCAL_RAG_TESSDATA_DIR=%LOCALAPPDATA%\RAF_Fiscal_Assistant\tessdata
FISCAL_RAG_OCR_LANGUAGES=fra+eng

# Primary provider (optional until an OpenAI API account is funded).
OPENAI_API_KEY=
FISCAL_RAG_OPENAI_MODEL=gpt-5.6-terra

# Fallback provider.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
FISCAL_RAG_OPENROUTER_MODEL=openai/gpt-5.6-terra

# OpenRouter privacy/routing controls.
FISCAL_RAG_OPENROUTER_DATA_COLLECTION=deny
FISCAL_RAG_OPENROUTER_ZDR=false

# Shared application settings.
FISCAL_RAG_REASONING=medium
FISCAL_RAG_PORT=8010
FISCAL_RAG_OPENAI_RETRY_SECONDS=300
